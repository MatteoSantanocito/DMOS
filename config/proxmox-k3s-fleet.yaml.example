        hubble_ui_node_port: 32080

      monitoring:
        enabled: true
        prometheus_node_port: 32090      # DMOS reads Prometheus on this NodePort
        grafana_node_port: 32000
        grafana_admin_password: "<GRAFANA_ADMIN_PASSWORD>"

      registry:
        hostname: <REGISTRY_HOST>
        http_port: 80

      nfs:
        enabled: true
        server: <NFS_SERVER_IP>
        data_dir: /data/nfs

    control_plane:
      - name: cp-01
        template: <VM_TEMPLATE>
        proxmox_node: <PVE_NODE_A>
        cores: 2
        memory: 4096
        disk_size: 40
        ip: <CLUSTER02_CP_IP>
        gateway: <GATEWAY_IP>
        dns: <DNS_IP>
        subnet_mask: 24

    workers:
      - name: worker-01
        template: <VM_TEMPLATE>
        proxmox_node: <PVE_NODE_A>
        cores: 6               # tier MEDIUM
        memory: 8192
        disk_size: 40
        ip: <CLUSTER02_WORKER_IP>
        gateway: <GATEWAY_IP>
        dns: <DNS_IP>
        subnet_mask: 24
        labels:
