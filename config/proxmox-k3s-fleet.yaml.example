  # -- ms-cluster-04 — US-VA, netem 100 ms, tier HIGH ---------------------------
  - name: ms-cluster-04
    kubeconfig_path: ./kubeconfig-ms-cluster-04
    pod_cidr: 10.72.0.0/16
    service_cidr: 10.73.0.0/16

    k3s:
      version: v1.36.0+k3s1
