    id: 1
  - cluster: ms-cluster-02
    id: 2
  - cluster: ms-cluster-03
    id: 3
  - cluster: ms-cluster-04
    id: 4
  - cluster: ms-cluster-05
    id: 5
  - cluster: ms-cluster-06
    id: 6
