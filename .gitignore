# ── Single source of truth & generated runtime files ──────────────────────
# config/local.yaml is the env-specific input (cluster IPs, SSH, netem,
# alertmanager webhook). The canonical IP-free template is
# config/local.yaml.example. Everything in .cache/ and the runtime version
# of alertmanager-config.yaml is generated from local.yaml by
# scripts/render-runtime-files.sh — never committed.
config/local.yaml
.cache/
deployments/alertmanager-config.yaml
bootstrap-commands.sh

# Legacy files superseded by local.yaml + .cache/ (kept on disk locally for
# operator convenience but never tracked).
config/clusters.yaml
config/monitoring.yaml
config/cilium-cluster*-values.yaml
config/cilium-current-values-*.yaml
config/ping-exporter-cluster*-values.yaml
deployments/ping-exporter-cluster*.yaml

