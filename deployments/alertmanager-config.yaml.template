# =============================================================================
# Alertmanager configuration for DMOS — TEMPLATE
# =============================================================================
#
# This is the IP-free template. The runtime version (`alertmanager-config.yaml`)
# is gitignored and generated by `scripts/render-runtime-files.sh` only when
# `alertmanager.webhook_url` is set in `config/local.yaml`.
#
# If you do not run Alertmanager, ignore this file entirely.
# =============================================================================

apiVersion: v1
kind: ConfigMap
metadata:
  name: alertmanager-dmos-config
  namespace: monitoring
data:
  config.yml: |
    global:
      resolve_timeout: 5m

    route:
      receiver: dmos-webhook
      group_wait: 5s
      group_interval: 10s
      repeat_interval: 5m
      group_by: ['alertname', 'service']

    receivers:
      - name: dmos-webhook
        webhook_configs:
          - url: '<OPERATOR_WEBHOOK_URL>'
            send_resolved: true
            http_config:
              follow_redirects: true
